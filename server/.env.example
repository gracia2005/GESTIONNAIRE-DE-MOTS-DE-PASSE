# SecureVault Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Supported drivers: 'sqlite' (zero-config local) or 'postgres'
DB_DRIVER=sqlite
# For PostgreSQL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=securevault
# DB_USER=postgres
# DB_PASSWORD=your_secure_password

# SQLite file path (used when DB_DRIVER=sqlite)
DB_SQLITE_PATH=./data/securevault.db

# Cookie & Session Security
SESSION_SECRET=change_this_to_a_random_32_char_secret_in_production
COOKIE_SECURE=false # Set to true in production with HTTPS
COOKIE_SAME_SITE=lax # 'strict' or 'lax'

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173
